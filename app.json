{
  "expo": {
    "name": "Kharadhu",
    "slug": "kharadhu",
    "scheme": "kharadhu",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F2F6F1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mv.kharadhu.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Kharadhu uses the camera so you can photograph a receipt and Raseedhu can read it.",
        "NSPhotoLibraryUsageDescription": "Kharadhu reads a receipt photo only when you choose one.",
        "NSFaceIDUsageDescription": "Kharadhu uses Face ID only if you turn on the app lock. Your face data stays on your phone."
      }
    },
    "android": {
      "package": "mv.kharadhu.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#1B332A"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kharadhu uses the camera so you can photograph a receipt.",
          "photosPermission": "Kharadhu reads a receipt photo only when you choose one."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kharadhu uses Face ID only if you turn on the app lock."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F6F1",
          "dark": {
            "backgroundColor": "#0F1714",
            "image": "./assets/images/splash-icon.png"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4980a5da-9655-44ff-a9d9-48c587870d42"
      }
    },
    "icon": "./assets/images/icon.png"
  }
}
